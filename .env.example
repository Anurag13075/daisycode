API_URL=http://localhost:3000

# Optional. Defaults to a local SQLite file under packages/database/prisma/
# DATABASE_URL=file:./packages/database/prisma/daisycode.db

# At least ONE of these provider keys is required for chat.
# DaisyCode works with OpenCode alone, Grok alone, Cerebras alone, or any combination.

# Free OpenCode Zen models — https://opencode.ai/zen
OPENCODE_API_KEY=

# xAI Grok free credits — https://console.x.ai
XAI_API_KEY=
# Optional alias for XAI_API_KEY
# GROK_API_KEY=

# Cerebras free-trial models — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

{
  "name": "daisycode",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:push": "bun run --cwd packages/database db:push",
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run db:push && bun run --hot packages/server/src/index.ts",
    "build:cli": "bun run --filter @daisycode/cli build",
    "build:server": "bun run --filter @daisycode/server build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
